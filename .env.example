# Copy to .env for local builds. On Netlify, add these under
# Site configuration -> Environment variables. Never commit real values.

# --- Shop Manager (Supabase) ---
# Public URL + anon key: used at BUILD time to read the published price list.
PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
# Organization slug of the shop in Shop Manager (organizations.slug).
SHOP_ORG_SLUG=
# Server-only: used by the enquiry function to save leads. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=
# organizations.id of the shop; leads are saved under this org.
SHOP_ORG_ID=

# --- Meta ---
# Pixel (Dataset) ID. Public — it's shipped to the browser.
PUBLIC_META_PIXEL_ID=
# Conversions API access token. Server-only. Keep secret.
META_CAPI_TOKEN=
# Optional: Events Manager "Test events" code while testing, then remove.
META_TEST_EVENT_CODE=

# --- Instagram feed (build time) ---
# Long-lived Instagram User access token (expires after 60 days; see docs/META_SETUP.md).
INSTAGRAM_ACCESS_TOKEN=
