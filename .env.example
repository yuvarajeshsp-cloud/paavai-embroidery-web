# All optional. Copy to .env for local builds. On Netlify, add these under
# Site configuration -> Environment variables. Never commit real values.

# --- Meta ---
# Pixel (Dataset) ID. Public — it's shipped to the browser.
PUBLIC_META_PIXEL_ID=
# Conversions API access token. Server-only. Keep secret.
META_CAPI_TOKEN=
# Optional: Events Manager "Test events" code while testing, then remove.
META_TEST_EVENT_CODE=

# --- Instagram feed (build time) ---
# Long-lived Instagram User access token (expires after 60 days; see docs/META_SETUP.md).
INSTAGRAM_ACCESS_TOKEN=
