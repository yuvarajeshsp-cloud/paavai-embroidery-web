---
import Logo from './Logo.astro';
import { localePath, t, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const s = t(lang);
const otherLang: Lang = lang === 'en' ? 'ta' : 'en';
const links = [
  { href: '/', label: s.nav.home },
  { href: '/designs', label: s.nav.designs },
  { href: '/services', label: s.nav.services },
  { href: '/about', label: s.nav.about },
  { href: '/contact', label: s.nav.contact },
];
---

<header class="header">
  <div class="container header__inner">
    <a href={localePath(lang, '/')} class="header__brand" aria-label="Paavai Embroidery – home">
      <Logo lang={lang} />
    </a>

    <nav class="header__nav" aria-label="Main">
      <details class="header__menu">
        <summary aria-label="Menu">
          <span class="header__burger" aria-hidden="true"></span>
        </summary>
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={localePath(lang, l.href)} aria-current={l.href === path || (l.href !== '/' && path.startsWith(`${l.href}/`)) || (l.href === '/designs' && path.startsWith('/design/')) ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>

    <a
      class="header__lang"
      href={localePath(otherLang, path)}
      hreflang={otherLang === 'ta' ? 'ta-IN' : 'en-IN'}
      lang={otherLang}
      aria-label={s.switchLangLabel}>{s.switchLang}</a
    >
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(246 246 255 / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 68px;
  }
  .header__brand {
    text-decoration: none;
    margin-right: auto;
  }
  .header__lang {
    font-weight: 600;
    text-decoration: none;
    border: 2px solid var(--periwinkle);
    border-radius: 999px;
    padding: 4px 14px;
    color: var(--ink);
    white-space: nowrap;
  }
  .header__lang:hover {
    background: var(--lavender);
  }
  .header__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .header__nav a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--periwinkle);
    text-underline-offset: 6px;
    text-decoration-thickness: 3px;
  }

  /* Phones: a disclosure menu that drops below the bar. */
  .header__menu summary {
    list-style: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 10px;
  }
  .header__menu summary::-webkit-details-marker {
    display: none;
  }
  .header__burger,
  .header__burger::before,
  .header__burger::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    position: relative;
  }
  .header__burger::before,
  .header__burger::after {
    content: '';
    position: absolute;
  }
  .header__burger::before {
    top: -7px;
  }
  .header__burger::after {
    top: 7px;
  }
  .header__menu[open] ul {
    position: absolute;
    left: 0;
    right: 0;
    top: 68px;
    background: var(--lavender-50);
    border-bottom: 1px solid var(--border);
    padding: 8px 16px 16px;
    box-shadow: var(--shadow);
  }
  .header__menu li a {
    display: block;
    padding: 12px 0;
  }

  /* Wider screens: show the links inline. */
  @media (min-width: 860px) {
    .header__nav {
      order: 0;
    }
    .header__menu summary {
      display: none;
    }
    .header__menu ul,
    .header__menu[open] ul {
      position: static;
      display: flex;
      gap: 24px;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
      margin-right: 16px;
    }
    .header__menu li a {
      padding: 0;
    }
  }
</style>

<script>
  // On wide screens the <details> menu must always be open.
  const menu = document.querySelector<HTMLDetailsElement>('.header__menu');
  const mq = window.matchMedia('(min-width: 860px)');
  const sync = () => {
    if (menu) menu.open = mq.matches;
  };
  sync();
  mq.addEventListener('change', sync);
</script>
