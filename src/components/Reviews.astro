---
// Reviews are edited in the admin page (/admin → Reviews), which saves
// src/data/reviews.json. Turn off "Sample" on real reviews.
import data from '../data/reviews.json';
import { site } from '../config/site';
import { t, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
}

type Review = {
  name: string;
  rating: number | string;
  text_en: string;
  text_ta?: string;
  source?: string;
  link?: string;
  sample?: boolean;
  hidden?: boolean;
};

const { lang } = Astro.props;
const s = t(lang);
const reviews = (data.reviews as Review[]).filter((r) => !r.hidden && r.text_en);
const hasLinks = site.googleReviewsUrl || site.googleWriteReviewUrl;
---

{
  (reviews.length > 0 || hasLinks) && (
    <section class="section section--tint">
      <div class="container">
        <h2 class="center">{s.reviewsTitle}</h2>
        {reviews.length > 0 && (
          <div class="grid grid--3">
            {reviews.map((r) => {
              const rating = Math.max(1, Math.min(5, Number(r.rating) || 5));
              return (
                <figure class="card review">
                  <div class="review__stars" aria-label={`${rating} / 5`}>
                    {'★'.repeat(rating)}
                    {'☆'.repeat(5 - rating)}
                  </div>
                  <blockquote>{(lang === 'ta' && r.text_ta) || r.text_en}</blockquote>
                  <figcaption>
                    — {r.name}
                    {r.source && (
                      <span class="review__source">
                        {' · '}
                        {r.link ? (
                          <a href={r.link} target="_blank" rel="noopener">
                            {r.source}
                          </a>
                        ) : (
                          r.source
                        )}
                      </span>
                    )}
                  </figcaption>
                  {r.sample && <p class="review__sample">{s.sampleReview}</p>}
                </figure>
              );
            })}
          </div>
        )}
        {hasLinks && (
          <div class="btn-row review__links">
            {site.googleReviewsUrl && (
              <a class="btn btn--ghost" href={site.googleReviewsUrl} target="_blank" rel="noopener">
                {s.googleReviews}
              </a>
            )}
            {site.googleWriteReviewUrl && (
              <a class="btn btn--primary" href={site.googleWriteReviewUrl} target="_blank" rel="noopener">
                {s.writeReview}
              </a>
            )}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .review {
    margin: 0;
  }
  .review__stars {
    color: #c79a1e;
    letter-spacing: 2px;
    font-size: 1.1rem;
  }
  .review blockquote {
    margin: 10px 0;
    font-size: 1.05rem;
  }
  .review figcaption {
    font-weight: 600;
    color: var(--ink-soft);
  }
  .review__source {
    font-weight: 400;
  }
  .review__sample {
    margin: 10px 0 0;
    font-size: 0.8rem;
    color: #8a5a00;
    background: #fff4d6;
    border-radius: 6px;
    padding: 2px 8px;
    display: inline-block;
  }
  .review__links {
    justify-content: center;
    margin-top: 28px;
  }
</style>
