---
import Base from '../layouts/Base.astro';
import ServicesList from '../components/ServicesList.astro';
import { whatsappLink } from '../config/site';
import { t, type Lang } from '../i18n/strings';
import { getServices } from '../lib/services';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const services = await getServices();
---

<Base lang={lang} title={s.servicesTitle} description={s.servicesIntro} path="/services">
  <section class="section">
    <div class="container">
      <h1>{s.servicesTitle}</h1>
      <p class="section__intro">{s.servicesIntro}</p>
      {services.length > 0 && <ServicesList lang={lang} services={services} />}
      <p class="ask">
        <a class="btn btn--whatsapp" href={whatsappLink(s.waGreeting)} data-wa="services-page" rel="noopener">{s.askQuote}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .ask {
    margin-top: 28px;
  }
</style>
