---
import Base from '../layouts/Base.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import ServicesList from '../components/ServicesList.astro';
import Reviews from '../components/Reviews.astro';
import { gallery } from '../data/gallery';
import { whatsappLink } from '../config/site';
import { localePath, t, type Lang } from '../i18n/strings';
import { getServices } from '../lib/services';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const services = await getServices();
const featured = gallery.filter((g) => g.featured).slice(0, 4);
---

<Base lang={lang} title={lang === 'ta' ? 'பாவை எம்ப்ராய்டரி — மணப்பெண் ஆரி & டிசைனர் எம்ப்ராய்டரி' : 'Paavai Embroidery — Bridal aari & designer embroidery'} description={s.heroText} path="/">
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow">{s.tagline}</p>
        <h1>{s.heroTitle}</h1>
        <p class="hero__text">{s.heroText}</p>
        <div class="btn-row">
          <a class="btn btn--whatsapp" href={whatsappLink(s.waGreeting)} data-wa="hero" rel="noopener">{s.ctaWhatsapp}</a>
          <a class="btn btn--ghost" href={localePath(lang, '/gallery')}>{s.ctaGallery}</a>
        </div>
      </div>
      <div class="hero__art" aria-hidden="true">
        <img src="/images/hero.svg" alt="" width="520" height="520" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{s.featuredTitle}</h2>
      <GalleryGrid lang={lang} items={featured} />
      <p class="more"><a class="btn btn--ghost" href={localePath(lang, '/gallery')}>{s.ctaGallery} →</a></p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2>{s.whyTitle}</h2>
      <div class="grid grid--3">
        {s.why.map((w) => (
          <div class="card">
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {services.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>{s.servicesTitle}</h2>
        <p class="section__intro">{s.servicesIntro}</p>
        <ServicesList lang={lang} services={services} limit={3} />
        <p class="more"><a class="btn btn--ghost" href={localePath(lang, '/services')}>{s.nav.services} →</a></p>
      </div>
    </section>
  )}

  <Reviews lang={lang} />

  <section class="section cta">
    <div class="container center">
      <h2>{s.contactTitle}</h2>
      <p class="section__intro">{s.contactIntro}</p>
      <div class="btn-row cta__row">
        <a class="btn btn--whatsapp" href={whatsappLink(s.waGreeting)} data-wa="home-cta" rel="noopener">{s.ctaWhatsapp}</a>
        <a class="btn btn--primary" href={localePath(lang, '/contact')}>{s.ctaEnquire}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: linear-gradient(160deg, var(--lavender) 0%, var(--lavender-50) 70%);
    padding: clamp(40px, 8vw, 96px) 0;
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .hero__inner {
      grid-template-columns: 1.15fr 1fr;
    }
    .hero__art img {
      width: min(100%, 460px);
    }
  }
  .hero__eyebrow {
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .hero__text {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 560px;
    margin-bottom: 1.6em;
  }
  .hero__art img {
    width: min(60%, 460px);
    margin: 0 auto;
  }
  .more {
    margin-top: 24px;
  }
  .cta__row {
    justify-content: center;
  }
</style>
